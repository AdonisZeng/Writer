# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.coverage
htmlcov/

# 打包产物（build.ps1 → PyInstaller）
build/
dist/
*.spec

# 内置字体二进制（体积大，由 tools/fetch_fonts.py 从官方源获取；
# 构建打包时 --add-data "assets;assets" 会自动携带本地已下载的字体）
assets/fonts/*.ttf
assets/fonts/*.otf

# 运行时配置（含 api_key，首次启动自动生成）
config.json

# 用户数据与项目运行库（首次启动自动生成）
novels/
*.db
*.db-wal
*.db-shm

# IDE / 系统
.idea/
.vscode/
.codebuddy/
.DS_Store
Thumbs.db
